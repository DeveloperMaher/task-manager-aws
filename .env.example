APP_NAME="Task Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---------- Database (RDS MySQL) ----------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=task_manager
DB_USERNAME=admin
DB_PASSWORD=

# ---------- Redis (ElastiCache) ----------
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- Session / Cache / Queue ----------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---------- S3 (file uploads) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
FILESYSTEM_DISK=s3

# ---------- SNS ----------
SNS_TOPIC_ARN=

# ---------- Mail (optional) ----------
MAIL_MAILER=log